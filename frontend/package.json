{
  "name": "script-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --config .prettierrc.json --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\" .prettierrc.json \"../backend/src/**/*.java\"",
    "format:check": "prettier --config .prettierrc.json --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,json,html}\" .prettierrc.json \"../backend/src/**/*.java\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "3.9.10",
    "prettier-plugin-java": "2.11.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.1"
  }
}
